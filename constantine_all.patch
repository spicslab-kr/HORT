+    Instruction* forceInvokeToCall(InvokeInst *II) {
+        // Convert an invoke to a normal call, drop the unwind edge, and branch to the normal dest.
+        BasicBlock *BB     = II->getParent();
+        BasicBlock *Normal = II->getNormalDest();
+        BasicBlock *Unwind = II->getUnwindDest();
+
+        // Collect call arguments (Invoke operands are Use*, so copy to Value* vector)
+        SmallVector<Value*, 8> Args;
+        Args.reserve(II->getNumArgOperands());
+        for (unsigned i = 0, e = II->getNumArgOperands(); i != e; ++i)
+            Args.push_back(II->getArgOperand(i));
+
+        // Preserve operand bundles (deopt, funclet, etc.)
+        SmallVector<OperandBundleDef, 2> Bundles;
+        II->getOperandBundlesAsDefs(Bundles);
+
+        // Build the call before the invoke
+        llvm::IRBuilder<> B(II);
+        CallInst *CI = B.CreateCall(II->getFunctionType(), II->getCalledValue(), Args, Bundles);
+        CI->setCallingConv(II->getCallingConv());
+        CI->setAttributes(II->getAttributes());
+        // NOTE: InvokeInst in LLVM 9 has no getTailCallKind(); do not copy it.
+        CI->setDebugLoc(II->getDebugLoc());
+
+        // Replace all uses of the invoke result if non-void
+        if (!II->getType()->isVoidTy())
+            II->replaceAllUsesWith(CI);
+
+        // Erase the invoke and terminate BB with a branch to the normal dest
+        II->eraseFromParent();
+        BranchInst::Create(Normal, BB);
+
+        // Remove incoming edge from BB in PHIs of the unwind dest (edge is gone now)
+        for (auto &I : *Unwind) {
+            if (auto *PN = dyn_cast<PHINode>(&I)) {
+                int idx = PN->getBasicBlockIndex(BB);
+                if (idx >= 0)
+                    PN->removeIncomingValue(idx, /*DeletePHIIfEmpty=*/false);
+            } else {
+                break; // PHIs are always first; done
+            }
+        }
+
+        // Unwind block will usually become unreachable and be cleaned up later.
+        return CI;
+    }
