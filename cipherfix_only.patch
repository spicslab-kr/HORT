+        if (tag_dir.table[i] == NULL) continue;
+
+        for (size_t j = 0; j < PAGETABLE_SZ; j++) {
+            if (tag_dir.table[i]->page[j] == NULL) continue;
+
+            total_tracked_mem += PAGE_SIZE;
+
+            tag_page_t *page = tag_dir.table[i]->page[j];
