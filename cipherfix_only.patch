+            // Update ELF header
+            elf.Header.SectionHeaderStringTableIndex = (ushort)sectionHeaderStringTableIndex;
+            elf.Header.SectionHeaderTableEntryCount = (ushort)elf.SectionHeaderTable.SectionHeaders.Count;
