+        {
+            int offset = 0;
+
+            var list = new List<RelocationEntry>();
+            for(int i = 0; i < entryCount; ++i)
+            {
+                var sectionHeader = new RelocationEntry
+                {
+                    Offset = buffer.ReadUInt64(ref offset),
+                    Info = buffer.ReadUInt64(ref offset),
